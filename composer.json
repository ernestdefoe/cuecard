{
    "name": "ernestdefoe/cuecard",
    "description": "Saved replies for Flarum: global macros for staff (per-group), personal macros for anyone allowed, inserted from the composer with search and placeholders, optionally locking, tagging or marking the best answer as the reply posts.",
    "keywords": ["flarum", "flarum-extension", "macros", "saved replies", "canned responses", "reply templates", "moderation"],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/cuecard",
    "support": {
        "issues": "https://github.com/ernestdefoe/cuecard/issues",
        "source": "https://github.com/ernestdefoe/cuecard"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Cue Cards",
            "category": "feature",
            "icon": {
                "name": "fas fa-layer-group",
                "backgroundColor": "#b45309",
                "color": "#ffffff"
            },
            "optional-dependencies": [
                "flarum/lock",
                "flarum/tags",
                "fof/best-answer"
            ]
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Cuecard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Cuecard\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "flarum/lock": "^2.0",
        "flarum/tags": "^2.0",
        "fof/best-answer": "^2.0@beta"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    }
}
